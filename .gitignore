# رازها هرگز نباید commit شوند (کلیدها، توکن‌ها). backend/.gitignore هم .env
# خودش را می‌گیرد؛ این خط ریشه‌ی پروژه را هم پوشش می‌دهد.
.env
.env.*
!.env.example

# Capacitor native projects (generated by `npx cap add`) —
# commit these once generated; only build artifacts inside them are ignored.
ios/App/Pods/
ios/App/build/
android/.gradle/
android/app/build/
android/build/
android/local.properties

