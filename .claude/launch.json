{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "routino-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5180", "--strictPort"],
      "port": 5180,
      "autoPort": false
    },
    {
      "name": "routino-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--", "--port", "4173", "--strictPort"],
      "port": 4173,
      "autoPort": false
    },
    {
      "name": "routino-landing",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "dist", "--port", "4180", "--strictPort"],
      "port": 4180,
      "autoPort": false
    },
    {
      "name": "routino-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "backend",
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "routino-api-once",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "src/index.ts"],
      "cwd": "backend",
      "port": 3000,
      "autoPort": false
    }
  ]
}
