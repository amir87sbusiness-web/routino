<?xml version="1.0" encoding="utf-8" ?>
<!--
  TEST-ONLY (debug builds only): allow cleartext HTTP so the app can reach the
  local dev backend (over `adb reverse tcp:3000 tcp:3000` or LAN) during testing.

  This file lives under src/debug, so it is merged ONLY into debug APKs. Release
  builds never see it and stay HTTPS-only. Safe to delete once device testing of
  the real backend is done.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
