# Copy to .env for local development. Never commit a real .env.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://routino:routino@localhost:5432/routino

# MUST include the Capacitor WebView origins or the Android app cannot call the
# API at all. Android is https://localhost (capacitor.config.ts sets
# androidScheme: 'https'); iOS is capacitor://localhost.
CORS_ORIGINS=http://localhost:5173,http://localhost:5180,https://localhost,capacitor://localhost

# true ONLY behind our own reverse proxy (Caddy in docker-compose). When false,
# x-forwarded-for is ignored so clients can't spoof their IP past rate limits.
TRUST_PROXY=false

# Secret for /admin and /v1/admin/*. Generate like JWT_SECRET below.
ADMIN_PHONE=
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-in-production-32+
# Stateless signed session: exactly 30 days by default. There is no refresh token
# or server-side device/session row.
ACCESS_TTL_SECONDS=2592000

OTP_PEPPER=dev-only-otp-pepper-change-me
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=3

# console prints the code to stdout. Switch to kavenegar once the OTP template
# is approved in their panel (human review — start it early).
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=routino-otp

# Payment gateway.
#
# PSP_PROVIDER:
#   fake     = a local Pay/Cancel page; the whole payment state machine is
#              testable with no external dependency (dev/test only).
#   zarinpal = the only production gateway. Needs the real 36-char merchant id.
PSP_PROVIDER=fake
ZARINPAL_MERCHANT=dev-only-zarinpal-merchant

# The gateway redirects the USER'S BROWSER here, so it must be reachable from
# their device. localhost works for web dev but can NEVER work from a phone —
# for device testing use a tunnel:  cloudflared tunnel --url http://localhost:3000
PUBLIC_API_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:5180
APP_DEEP_LINK=routino://pay/result

IMPORT_MAX_DAYS=400

# ── Off-box database backups (docker-compose `backup` service) ───────────────
#
# Only read by the backup container, never by the API. Leave empty in dev.
#
# In production these are the difference between a backup and a decoration:
# without them pg_dump still runs, but the dumps stay in a volume on the SAME
# machine as Postgres — and losing that machine is the most likely way to lose
# the database in the first place. The container warns on every cycle when they
# are unset, so an empty value here is a choice, not an accident.
#
# Use a bucket SEPARATE from any public/frontend one: these files contain every
# user's data. Any S3-compatible provider works (ArvanCloud, Liara, Parspack).
#   S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# How often to dump, and how long to keep LOCAL copies. Remote retention is
# deliberately left to a bucket lifecycle rule instead: a backup container that
# can delete its own off-box history is one bug away from deleting all of it.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=30
