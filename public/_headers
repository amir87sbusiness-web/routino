# Cloudflare Pages: کنترل کش. مهم‌ترین تنظیم کل انتشار.
#
# قانون طلایی: هر چیزی که اسمش ثابت است (index.html, sw.js, manifest) نباید
# کش شود، وگرنه کاربر آپدیت نمی‌گیرد و روی نسخه‌ی قدیمی یخ می‌زند. هر چیزی که
# اسمش هش‌دار است (assets/*) بی‌خطر می‌تواند ابدی کش شود، چون با هر بیلد اسمش
# عوض می‌شود.

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
